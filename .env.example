# 비워 두면 데모 저장소로 동작해요.
GITHUB_APP_ID=
# GitHub App 주소의 이름 (예: https://github.com/apps/<이 값>). 설치 버튼을 만들 때 써요.
GITHUB_APP_SLUG=
# 내려받은 .pem 파일 경로 (로컬) 또는 PEM 내용 전체 (배포, 줄바꿈은 \n)
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# GitHub로 시작하기(사용자 로그인)용. 앱 설정 General의 Client ID와, "Generate a new client secret"으로 만든 값 (비밀값은 올리지 않아요)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 외부에서 여는 서비스 주소. OAuth 콜백과 디스코드 알림 링크에 써요.
BENTO_PUBLIC_URL=
BENTO_APP_URL=
# 매일 알림(크론)을 부를 때 확인하는 비밀값. 아무 긴 무작위 문자열
CRON_SECRET=
# 기본으로 볼 저장소 (owner/name)
BENTO_REPO=
# 제안 서명용 비밀값. 아무 긴 무작위 문자열.
BENTO_SIGNING_KEY=
# 설정하면 실행할 때 이 코드를 물어봐요. 배포 주소가 공개라면 꼭 설정하세요.
BENTO_ACCESS_CODE=
# 공고 분석·자유 대화용 Claude API 키. 없어도 규칙 기반 기능과 데모는 동작해요.
ANTHROPIC_API_KEY=
# 디스코드 채널 웹훅 주소 (팀 메시지용, 선택)
DISCORD_WEBHOOK_URL=
# 리뷰 대기 몇 시간부터 알릴지 (기본 24)
BENTO_REVIEW_WAIT_HOURS=
